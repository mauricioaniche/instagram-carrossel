{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "coverText",
    "reelTitle",
    "slides",
    "scenes",
    "visual"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "reelTitle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "heading",
          "body"
        ],
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "body": {
            "type": "string",
            "maxLength": 220
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "texto"
        ],
        "properties": {
          "texto": {
            "type": "string",
            "minLength": 1,
            "maxLength": 140
          }
        }
      }
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "prompt",
        "scene"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "scene": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "prompt": {
          "type": "string",
          "minLength": 30,
          "maxLength": 1800
        }
      }
    },
    "coverText": {
      "type": "string",
      "maxLength": 160
    }
  }
}
